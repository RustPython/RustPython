+// Count at the decoder boundary, not at a buffered source that can read ahead.
+struct CountingRead<'a, R> { source: &'a mut R, bytes: usize }
+impl<R: Read> Read for CountingRead<'_, R> {
+    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+        let n = self.source.read(buffer)?;
+        self.bytes += n;
+        Ok(n)
+    }
+}
