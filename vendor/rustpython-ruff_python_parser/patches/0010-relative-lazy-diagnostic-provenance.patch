+/// An owned, same-source/mode lexer state, captured before parser recovery.
+///
+/// The source cannot be substituted by a consumer. Resuming clones the lexical
+/// stacks but does not replay parser callbacks or consume any recovered tokens.
+#[derive(Debug, Clone, PartialEq, Eq, get_size2::GetSize)]
+pub struct DiagnosticLexerSnapshot {
+    source: Box<str>,
+    mode: Mode,
+    state: LexerCheckpoint,
+    seed: crate::diagnostic_events::DiagnosticTokenRead,
+}
+
+impl DiagnosticLexerSnapshot {
+    pub fn source(&self) -> &str {
+        &self.source
+    }
+
+    pub const fn mode(&self) -> Mode {
+        self.mode
+    }
+
+    /// The already-read first target, not a newly produced continuation token.
+    pub const fn seed(&self) -> &crate::diagnostic_events::DiagnosticTokenRead {
+        &self.seed
+    }
+
+    /// Bind a completed grammar action's already-filled read prefix to this
+    /// exact original lexer before exposing its unread suffix. A mismatched or
+    /// recovered prefix is unavailable evidence, never successful exhaustion.
+    pub fn resume_after(
+        &self,
+        reads: &[crate::diagnostic_events::DiagnosticTokenRead],
+        continuity: crate::diagnostic_events::DiagnosticContinuity,
+        frontier: usize,
+    ) -> Result<DiagnosticLexerFork<'_>, DiagnosticForkBindingError> {
+        use crate::diagnostic_events::{DiagnosticContinuity, DiagnosticReadOrigin};
+        let DiagnosticContinuity::SingleStream { divergence } = continuity else {
+            return Err(DiagnosticForkBindingError::IndependentStreams);
+        };
+        if let Some(divergence) = divergence.filter(|divergence| divergence.next_read <= frontier) {
+            return Err(DiagnosticForkBindingError::Diverged(divergence));
+        }
+        if self.seed.ordinal != 0 || frontier >= reads.len() {
+            return Err(DiagnosticForkBindingError::UnboundFrontier { read: frontier });
+        }
+        let Some(seed) = reads.first() else {
+            return Err(DiagnosticForkBindingError::UnboundFrontier { read: frontier });
+        };
+        if seed.origin != DiagnosticReadOrigin::FirstPass || !same_original_read(seed, &self.seed) {
+            return Err(DiagnosticForkBindingError::ReadMismatch { read: 0 });
+        }
+        let mut fork = self.resume();
+        for (ordinal, committed) in reads.iter().enumerate().take(frontier + 1).skip(1) {
+            let Some(original) = fork.next_read() else {
+                return Err(DiagnosticForkBindingError::StoppedBeforeFrontier {
+                    frontier,
+                    termination: fork.termination.expect("stopped fork has an explicit reason"),
+                });
+            };
+            if committed.ordinal != ordinal
+                || committed.origin != DiagnosticReadOrigin::FirstPass
+                || !same_original_read(committed, &original)
+            {
+                return Err(DiagnosticForkBindingError::ReadMismatch { read: ordinal });
+            }
+        }
+        if let Some(termination) = &fork.termination
+            && !matches!(termination, DiagnosticForkTermination::EndOfInput { .. })
+        {
+            return Err(DiagnosticForkBindingError::FailureAlreadyRead(termination.clone()));
+        }
+        Ok(fork)
+    }
+
+    /// Continue the original lexer only. Consumers must independently establish
+    /// CPython parser reachability and control flags; this is not a second parser.
+    pub fn resume(&self) -> DiagnosticLexerFork<'_> {
+        let mut lexer = Lexer::new(&self.source, self.mode, TextSize::new(0));
+        lexer.rewind(self.state.clone());
+        DiagnosticLexerFork {
+            lexer,
+            next_read: self.seed.ordinal + 1,
+            next_token_slot: self.seed.token_slot + 1,
+            termination: fork_termination(&self.seed),
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DiagnosticForkBindingError {
+    IndependentStreams,
+    Diverged(crate::diagnostic_events::LexicalDivergence),
+    UnboundFrontier { read: usize },
+    ReadMismatch { read: usize },
+    StoppedBeforeFrontier {
+        frontier: usize,
+        termination: DiagnosticForkTermination,
+    },
+    FailureAlreadyRead(DiagnosticForkTermination),
+}
+
+fn same_original_read(
+    committed: &crate::diagnostic_events::DiagnosticTokenRead,
+    original: &crate::diagnostic_events::DiagnosticTokenRead,
+) -> bool {
+    // Origin differs intentionally for a fork. Every other provenance field,
+    // including warnings/discoveries and historical slot, must match exactly.
+    committed.ordinal == original.ordinal
+        && committed.token_slot == original.token_slot
+        && committed.token == original.token
+        && committed.read_range == original.read_range
+        && committed.discoveries == original.discoveries
+        && committed.warnings == original.warnings
+        && committed.type_comment == original.type_comment
+        && committed.end_of_input == original.end_of_input
+}
+
+/// Why original lexical continuation stopped. None is never used to imply EOF.
+#[derive(Debug, Clone, PartialEq, Eq, get_size2::GetSize)]
+pub enum DiagnosticForkTermination {
+    EndOfInput { read: usize },
+    HardStop {
+        read: usize,
+        discovery: crate::diagnostic_events::LexicalDiscovery,
+    },
+    UnclassifiedDiscovery {
+        read: usize,
+        discovery: crate::diagnostic_events::LexicalDiscovery,
+    },
+    MissingRead { read: usize },
+}
+
+/// A fork borrows only its owned snapshot's source. No parser recovery methods
+/// are exposed, and no recovered AST or caller-supplied source is consulted.
+#[derive(Debug)]
+pub struct DiagnosticLexerFork<'src> {
+    lexer: Lexer<'src>,
+    next_read: usize,
+    next_token_slot: usize,
+    termination: Option<DiagnosticForkTermination>,
+}
+
+impl DiagnosticLexerFork<'_> {
+    pub const fn termination(&self) -> Option<&DiagnosticForkTermination> {
+        self.termination.as_ref()
+    }
+
+    /// Return one original read, including a terminal failed read. Warnings and
+    /// failures within that read retain their individual observation cursors.
+    pub fn next_read(&mut self) -> Option<crate::diagnostic_events::DiagnosticTokenRead> {
+        use crate::diagnostic_events::{DiagnosticReadOrigin, DiagnosticTokenRead};
+        use ruff_python_ast::token::Token;
+        if self.termination.is_some() {
+            return None;
+        }
+        let discoveries_before = self.lexer.diagnostic_discoveries.len();
+        self.lexer.next_token();
+        let token = Token::new(
+            self.lexer.current_kind(), self.lexer.current_range(), self.lexer.current_flags(),
+        );
+        let discoveries = self.lexer.diagnostic_discoveries[discoveries_before..].to_vec();
+        let read = DiagnosticTokenRead {
+            ordinal: self.next_read,
+            // Continuation slots describe this independent stream, not the
+            // parser's buffer after it has requested recovery or truncated it.
+            token_slot: self.next_token_slot,
+            read_range: (!discoveries.iter().any(|error| error.token_range.is_none()))
+                .then(|| self.lexer.diagnostic_read_range()),
+            origin: DiagnosticReadOrigin::TokenizerContinuation,
+            discoveries,
+            warnings: self.lexer.diagnostic_warnings().to_vec(),
+            type_comment: crate::diagnostic_events::classify_type_comment(self.lexer.source, &token),
+            end_of_input: token.kind() == TokenKind::EndOfFile,
+            token,
+        };
+        self.next_read += 1;
+        self.next_token_slot += 1;
+        self.termination = fork_termination(&read);
+        Some(read)
+    }
+}
+
+fn fork_termination(
+    read: &crate::diagnostic_events::DiagnosticTokenRead,
+) -> Option<DiagnosticForkTermination> {
+    use crate::diagnostic_events::LexicalDisposition;
+    if let Some(discovery) = read.discoveries.iter().find(|discovery| {
+        !discovery.eof_cleanup && discovery.disposition != LexicalDisposition::ParserToken
+    }) {
+        return Some(match discovery.disposition {
+            LexicalDisposition::BareErrorToken | LexicalDisposition::RaisedErrorToken => {
+                DiagnosticForkTermination::HardStop { read: read.ordinal, discovery: discovery.clone() }
+            }
+            LexicalDisposition::DecoderOrUnclassified => {
+                DiagnosticForkTermination::UnclassifiedDiscovery {
+                    read: read.ordinal, discovery: discovery.clone(),
+                }
+            }
+            LexicalDisposition::ParserToken => unreachable!(),
+        });
+    }
+    if read.read_range.is_none() {
+        return Some(DiagnosticForkTermination::MissingRead { read: read.ordinal });
+    }
+    read.end_of_input.then_some(DiagnosticForkTermination::EndOfInput { read: read.ordinal })
+}
